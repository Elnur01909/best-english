# ── Telegram (məcburi) ── Ən asan yol: setup.bat (Windows) və ya: python -m leadsbot setup
# BotFather-dən alınan token (məs. 123456789:AAH...). Heç vaxt git-ə commit etməyin.
TELEGRAM_BOT_TOKEN=
# Mesajların gedəcəyi çat ID-ləri (vergüllə bir neçəsi ola bilər).
TELEGRAM_CHAT_ID=

# ── Claude süni intellekt filtri (isteğe bağlı) ──
# platform.claude.com → API Keys. Boş qalsa, bot açar söz filtri ilə işləyir.
ANTHROPIC_API_KEY=
# Model: claude-opus-5-5 (defolt, ən dəqiq, ~20$/ay) və ya claude-haiku-5-5 (çox ucuz, <1$/ay)
AI_MODEL=claude-opus-5-5
# Bundan aşağı bal alan lidlər göndərilmir (1-10). Telegram-da /minscore ilə də dəyişir.
AI_MIN_SCORE=6
# Səhər xülasəsi açıq olanda bu və daha yüksək ballı lidlər dərhal gəlir.
INSTANT_MIN_SCORE=8

# ── Səhər xülasəsi (isteğe bağlı) ──
# Boş = hər lid dərhal gəlir. "09:00" = qalan lidlər hər səhər bir mesajda. Telegram-da /digest ilə də dəyişir.
DIGEST_TIME=
# Bakı vaxtı UTC+4
TZ_OFFSET_HOURS=4

# ── Ümumi ──
# Mənbələrin neçə dəqiqədən bir yoxlanacağı (serve rejimi üçün)
FETCH_INTERVAL_MIN=30
# Bir dövrədə Telegram-a göndəriləcək maksimum mesaj sayı (qalanı növbəyə düşür)
MAX_PER_CYCLE=15
# HTTP sorğuları üçün User-Agent
USER_AGENT=linux:legal-leads-bot:1.0 (contact: your-email@example.com)

# İstəyə görə: ReliefWeb API v2 üçün təsdiqlənmiş appname (reliefweb_api_az mənbəsi üçün)
# RELIEFWEB_APPNAME=

# İstəyə görə: /update yeniləmələrinin gəldiyi yer (defolt aşağıdakılardır)
# UPDATE_REPO=Elnur01909/best-english
# UPDATE_BRANCH=claude/legal-aid-azerbaijan-research-3roqlx

# Telegram-a hansı lid növləri gəlsin: individual, job, tender, company, dispute. Telegram-da /types ilə də dəyişir.
LEAD_TYPES=individual,job,tender,company
# Şirkət xəbərləri yalnız bu və daha yüksək balla, səhər xülasəsində gəlir (Claude lazımdır). 0 = adi lid kimi dərhal.
SIGNAL_MIN_SCORE=9
# Tarixi bundan köhnə olan elementlər göndərilmir (gün). 0 = yoxlama yoxdur.
MAX_AGE_DAYS=30


# İstəyə görə: healthchecks.io keçidi. Bot susanda sizə xəbər gəlir. Telegram-da /health ilə də qoyulur.
# HEALTHCHECK_URL=
